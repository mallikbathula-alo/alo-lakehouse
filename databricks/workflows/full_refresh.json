{
  "name": "alo-lakehouse-full-refresh",
  "description": "Weekly full refresh of all dbt models",
  "tags": {
    "project": "alo-lakehouse",
    "schedule": "weekly"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 1 ? * SUN",
    "timezone_id": "America/Los_Angeles",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 14400,
  "email_notifications": {
    "on_failure": ["data-engineering@aloyoga.com"],
    "on_start": ["data-engineering@aloyoga.com"]
  },
  "run_as": {
    "user_name": "data.engineering@aloyoga.com"
  },
  "git_source": {
    "git_url": "https://github.com/mallikbathula-alo/alo-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "dbt_env",
      "spec": {
        "client": "1",
        "dependencies": ["dbt-databricks==1.9.4"]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "full_refresh_bronze",
      "description": "Full refresh all bronze models",
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": ["dbt run --full-refresh --select path:models/1_bronze/ --target dev"],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    },
    {
      "task_key": "full_refresh_silver",
      "description": "Full refresh all silver models",
      "depends_on": [{"task_key": "full_refresh_bronze"}],
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": [
          "dbt run --full-refresh --select path:models/2_silver_pre/ path:models/3_silver/ path:models/4_silver_post/ --target dev"
        ],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    },
    {
      "task_key": "full_refresh_gold",
      "description": "Full refresh all gold models",
      "depends_on": [{"task_key": "full_refresh_silver"}],
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": ["dbt run --full-refresh --select path:models/5_gold/ --target dev"],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    },
    {
      "task_key": "dbt_tests_post_refresh",
      "description": "Full test suite after refresh",
      "depends_on": [{"task_key": "full_refresh_gold"}],
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": ["dbt test --target dev"],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    }
  ]
}
