{
  "name": "alo-lakehouse-daily-run",
  "description": "Daily dbt medallion pipeline: bronze → silver → gold",
  "tags": {
    "project": "alo-lakehouse",
    "schedule": "daily"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 4 * * ?",
    "timezone_id": "America/Los_Angeles",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "health": {
    "rules": [
      {
        "metric": "RUN_DURATION_SECONDS",
        "op": "GREATER_THAN",
        "value": 5400
      }
    ]
  },
  "email_notifications": {
    "on_failure": ["data-engineering@aloyoga.com"],
    "no_alert_for_skipped_runs": false
  },
  "run_as": {
    "user_name": "data.engineering@aloyoga.com"
  },
  "git_source": {
    "git_url": "https://github.com/mallikbathula-alo/alo-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "environments": [
    {
      "environment_key": "dbt_env",
      "spec": {
        "client": "1",
        "dependencies": ["dbt-databricks==1.9.4"]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "description": "Run all bronze ingestion models",
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": ["dbt run --select path:models/1_bronze/ --target dev"],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    },
    {
      "task_key": "silver",
      "description": "Run all silver transformation models",
      "depends_on": [{"task_key": "bronze"}],
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": [
          "dbt run --select path:models/2_silver_pre/ path:models/3_silver/ path:models/4_silver_post/ --target dev"
        ],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    },
    {
      "task_key": "gold",
      "description": "Run all gold analytics models",
      "depends_on": [{"task_key": "silver"}],
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": ["dbt run --select path:models/5_gold/ --target dev"],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    },
    {
      "task_key": "dbt_tests",
      "description": "Run dbt tests across all layers",
      "depends_on": [{"task_key": "gold"}],
      "environment_key": "dbt_env",
      "dbt_task": {
        "commands": ["dbt test --target dev"],
        "project_directory": "lakehouse",
        "warehouse_id": "5bbd12e17dcc2628",
        "source": "GIT"
      },
      "run_if": "ALL_SUCCESS"
    }
  ]
}
