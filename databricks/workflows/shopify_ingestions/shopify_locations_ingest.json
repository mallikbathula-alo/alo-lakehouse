{
  "name": "shopify-locations-ingest",
  "description": "AutoLoader streaming ingest for Shopify GraphQL Locations API \u2192 alo_dev.bronze.shopify_gq_locations",
  "tags": {
    "project": "alo-lakehouse",
    "layer": "bronze",
    "source": "shopify-graphql-kinesis"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 * * * ?",
    "timezone_id": "America/Los_Angeles",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 1800,
  "email_notifications": {
    "on_failure": [
      "mallik.bathula@aloyoga.com"
    ],
    "no_alert_for_skipped_runs": false
  },
  "environments": [
    {
      "environment_key": "ingest_env",
      "spec": {
        "client": "2",
        "dependencies": [
          "pyyaml"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "ingest_shopify_locations",
      "description": "Read Shopify locations from Firehose Volume via AutoLoader, write to Delta",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_locations.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    }
  ],
  "run_as": {
    "user_name": "data.engineering@aloyoga.com"
  },
  "git_source": {
    "git_url": "https://github.com/mallikbathula-alo/alo-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  }
}
