{
  "name": "shopify-ingest-pipeline",
  "description": "Hourly AutoLoader ingestion pipeline for all Shopify GraphQL datasets -> alo_dev.bronze.*",
  "tags": {
    "project": "alo-lakehouse",
    "layer": "bronze",
    "source": "shopify-graphql",
    "type": "ingest",
    "jobType": "pipeline"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 * * * ?",
    "timezone_id": "America/Los_Angeles",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "email_notifications": {
    "on_failure": [
      "mallik.bathula@aloyoga.com"
    ],
    "no_alert_for_skipped_runs": false
  },
  "environments": [
    {
      "environment_key": "ingest_env",
      "spec": {
        "client": "2",
        "dependencies": [
          "pyyaml"
        ]
      }
    }
  ],
  "tasks": [
    {
      "task_key": "orders",
      "description": "Shopify Orders -> shopify_gq_orders",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_orders.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "customers",
      "description": "Shopify Customers -> shopify_gq_customers",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_customers.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "products",
      "description": "Shopify Products -> shopify_gq_products",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_products.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "collections",
      "description": "Shopify Collections -> shopify_gq_collections",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_collections.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "giftcards",
      "description": "Shopify Gift Cards -> shopify_gq_giftcards",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_giftcards.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "locations",
      "description": "Shopify Locations -> shopify_gq_locations",
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_locations.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "transactions",
      "description": "Shopify Transactions -> shopify_gq_transactions",
      "depends_on": [
        {
          "task_key": "orders"
        }
      ],
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_transactions.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "refunds",
      "description": "Shopify Refunds -> shopify_gq_refunds",
      "depends_on": [
        {
          "task_key": "orders"
        }
      ],
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_refunds.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "lineitems",
      "description": "Shopify Line Items -> shopify_gq_lineitems",
      "depends_on": [
        {
          "task_key": "orders"
        }
      ],
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_lineitems.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    },
    {
      "task_key": "fulfillments",
      "description": "Shopify Fulfillments -> shopify_gq_fulfillments",
      "depends_on": [
        {
          "task_key": "orders"
        }
      ],
      "environment_key": "ingest_env",
      "spark_python_task": {
        "python_file": "lakehouse/ingestions/shopify/shopify_fulfillments.py",
        "source": "GIT",
        "parameters": [
          "--run-mode",
          "streaming",
          "--source-catalog",
          "alo_dev"
        ]
      }
    }
  ],
  "run_as": {
    "user_name": "data.engineering@aloyoga.com"
  },
  "git_source": {
    "git_url": "https://github.com/mallikbathula-alo/alo-lakehouse",
    "git_provider": "gitHub",
    "git_branch": "main"
  }
}
